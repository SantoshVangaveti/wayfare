# Supabase -> Settings -> Database. You need BOTH.
DATABASE_URL="postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://...@...supabase.com:5432/postgres"

# Any long random string. Encrypts the AI key stored in AppSettings.
SETTINGS_SECRET="change-me-to-something-long-and-random"

# Supabase -> Settings -> API (for the public photos bucket)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# NOTE: there is deliberately no AI key here.
# It is entered in /settings and stored encrypted in the database.
